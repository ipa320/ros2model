{{ model.name }}:
{% if model.topics()|length > 0 %}
  msgs:
{% for spec in model.topics() %}
    {{ spec.name }}
      message
{% for part in spec.message.messagePart %}
{% set type_str = part.type %}
{% if '/' in type_str %}
{% set parts = type_str.split('[', 1) %}
{% if parts|length > 1 %}
{% set base = parts[0] %}
{% set suffix = '[' ~ parts[1] %}
{% else %}
{% set base = type_str %}
{% set suffix = '' %}
{% endif %}
        "{{ base }}"{{ suffix }} {{ part.data }}
{% else %}
        {{ type_str }} {{ part.data }}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
